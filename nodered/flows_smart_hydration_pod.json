  {
    "id": "fn_split_telemetry",
    "type": "function",
    "z": "tab_hydropod",
    "name": "Map Telemetry to Virtual Pins",
    "func": "var data = msg.payload;\n\n// Virtual Pin V0: Drank ml\nvar msg_v0 = { payload: data.drank_today_ml || 0 };\n\n// Virtual Pin V1: Bottle remaining ml\nvar msg_v1 = { payload: data.bottle_ml || 0 };\n\n// Virtual Pin V5: Battery %\nvar msg_v5 = { payload: data.battery_soc || 0 };\n\n// Safety status text\nvar msg_status = { payload: 'Trạng thái: ' + (data.safety_status || 'NORMAL') + ' | ' + (data.last_event || '') };\n\n// Check Dual Safety Margin (Rule Automation)\nvar msg_alert = null;\nif (data.hard_cap_ml > 0 && data.drank_today_ml >= data.hard_cap_ml) {\n    msg_alert = { payload: '🚨 CẢNH BÁO: Bệnh nhân đã vượt trần nạp dịch ' + data.drank_today_ml + '/' + data.hard_cap_ml + 'ml!' };\n}\n\nreturn [msg_v0, msg_v1, msg_v5, msg_status, msg_alert];",
    "outputs": 5,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 140,
    "wires": [
      ["ui_gauge_v0", "ui_chart_v0"],
      ["ui_gauge_v1"],
      ["ui_gauge_v5"],
      ["ui_text_status"],
      ["ui_notif_alert"]
    ]
  },
