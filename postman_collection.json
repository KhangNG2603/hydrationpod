{
  "info": {
    "_postman_id": "hydropod-iot-collection-v1",
    "name": "Smart Hydration Pod - IoT Test Suite",
    "description": "Bộ kịch bản kiểm thử HTTP REST API & MQTT Bridge cho đồ án Smart Hydration Pod.\nPhù hợp kiểm thử độc lập qua Postman và đồng bộ trực tiếp với mô phỏng Wokwi ESP32 & Web Dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Telemetry & Monitoring",
      "item": [
        {
          "name": "GET Current Telemetry (Virtual Pins)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/telemetry",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "telemetry"]
            },
            "description": "Lấy toàn bộ thông số thời gian thực: lượng nước đã uống (V0), dung tích còn lại (V1), % hoàn thành (V4), pin (V5), trạng thái an toàn."
          },
          "response": []
        },
        {
          "name": "GET API Documentation & Routes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/help",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "help"]
            },
            "description": "Xem danh sách các endpoint hỗ trợ kiểm thử."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Điều Khiển & Nạp Dịch (Commands)",
      "item": [
        {
          "name": "POST Drink Water (+150ml)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount_ml\": 150\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/drink",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "drink"]
            },
            "description": "Mô phỏng thao tác uống 150ml nước. Hệ thống sẽ publish MQTT điều khiển xuống Wokwi ESP32 và cập nhật Web Dashboard."
          },
          "response": []
        },
        {
          "name": "POST Set Profile Heart Failure (Hard Cap 1000ml)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": \"HEART_FAILURE\",\n  \"hard_cap\": 1000\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/profile",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "profile"]
            },
            "description": "Chỉ định y tế: Chuyển sang chế độ hạn chế dịch cho bệnh nhân suy tim/suy thận với trần kiểm soát 1000ml."
          },
          "response": []
        },
        {
          "name": "POST Set Profile Standard (2000ml)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": \"STANDARD\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/profile",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "profile"]
            },
            "description": "Chuyển về chế độ người bình thường (mục tiêu 2000ml/ngày, không áp trần nghiêm ngặt)."
          },
          "response": []
        },
        {
          "name": "POST Alarm Mute",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"MUTE\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/alarm",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "alarm"]
            },
            "description": "Tạm thời tắt chuông còi báo động trên phần cứng ESP32."
          },
          "response": []
        },
        {
          "name": "POST Daily Reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "http://localhost:8000/api/reset",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "reset"]
            },
            "description": "Reset toàn bộ chỉ số về 0 đầu ngày mới."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Kịch Bản Demo Nhanh (1, 2, 3)",
      "item": [
        {
          "name": "DEMO 1: Uống hợp lệ (+150ml)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"SIM_DEMO_SCENARIO_1\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/command",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "command"]
            },
            "description": "Kích hoạt Demo 1: Nạp 150ml, LED xanh, chuông xác nhận."
          },
          "response": []
        },
        {
          "name": "DEMO 2: Quên uống nước (Cảnh báo 35s)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"SIM_DEMO_SCENARIO_2\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/command",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "command"]
            },
            "description": "Kích hoạt Demo 2: Cảnh báo quên uống nước sau 35s không vận động."
          },
          "response": []
        },
        {
          "name": "DEMO 3: Báo động Vượt trần Y tế (1050/1000ml)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"SIM_DEMO_SCENARIO_3\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/command",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "command"]
            },
            "description": "Kích hoạt Demo 3: Báo động nguy hiểm màu đỏ cấp cứu khi bệnh nhân uống vượt 1000ml chỉ định."
          },
          "response": []
        }
      ]
    }
  ]
}
