{
  "version": 1,
  "author": "Smart Hydration Pod - Sensor-Driven IoT",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-ssd1306",
      "id": "oled",
      "top": -160,
      "left": -60,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-mpu6050",
      "id": "mpu",
      "top": -160,
      "left": 150,
      "attrs": {}
    },
    {
      "type": "wokwi-hx711",
      "id": "hx711",
      "top": 150,
      "left": -180,
      "attrs": { "type": "5kg" }
    },
    {
      "type": "wokwi-neopixel-ring",
      "id": "ring1",
      "top": 160,
      "left": 180,
      "attrs": { "pixels": "8" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 180,
      "left": 30,
      "attrs": { "volume": "0.1" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:21", "oled:SDA", "green", [ "v-20", "h-50" ] ],
    [ "esp:22", "oled:SCL", "blue", [ "v-30", "h-40" ] ],
    [ "oled:GND", "esp:GND.1", "black", [] ],
    [ "oled:VCC", "esp:3V3", "red", [] ],
    [ "esp:21", "mpu:SDA", "green", [ "v-20", "h100" ] ],
    [ "esp:22", "mpu:SCL", "blue", [ "v-30", "h110" ] ],
    [ "mpu:GND", "esp:GND.1", "black", [] ],
    [ "mpu:VCC", "esp:3V3", "red", [] ],
    [ "esp:16", "hx711:DT", "purple", [] ],
    [ "esp:17", "hx711:SCK", "orange", [] ],
    [ "hx711:GND", "esp:GND.1", "black", [] ],
    [ "hx711:VCC", "esp:3V3", "red", [] ],
    [ "esp:15", "ring1:DIN", "yellow", [] ],
    [ "ring1:GND", "esp:GND.2", "black", [] ],
    [ "ring1:VCC", "esp:5V", "red", [] ],
    [ "esp:4", "bz1:1", "red", [] ],
    [ "bz1:2", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
